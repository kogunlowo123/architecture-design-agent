# Copy to .env and adjust. Every variable is optional.

# Pricing
# ARCHAGENT_PRICING_FILE=configs/pricing.example.yaml

# Optional model-written summaries
# llm_provider: none | openai | anthropic. The model only sees aggregate counts, never component names.
ARCHAGENT_LLM_PROVIDER=none
# ARCHAGENT_OPENAI_API_KEY=
ARCHAGENT_OPENAI_BASE_URL=https://api.openai.com/v1
ARCHAGENT_OPENAI_CHAT_MODEL=gpt-4o-mini
# ARCHAGENT_ANTHROPIC_API_KEY=
ARCHAGENT_ANTHROPIC_BASE_URL=https://api.anthropic.com
ARCHAGENT_ANTHROPIC_MODEL=claude-sonnet-5
ARCHAGENT_ANTHROPIC_MAX_TOKENS=500

# HTTP and logging
ARCHAGENT_HTTP_TIMEOUT_SECONDS=30
ARCHAGENT_RETRY_ATTEMPTS=3
ARCHAGENT_RETRY_MIN_WAIT=0.5
ARCHAGENT_RETRY_MAX_WAIT=8
ARCHAGENT_LOG_LEVEL=WARNING
ARCHAGENT_LOG_JSON=true
